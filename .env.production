# 生产环境配置

# API 基础地址（通过 Nginx 代理）
# 前端通过 /api 访问，Nginx 会代理到 localhost:3000
VITE_API_BASE_URL=/api

# WebSocket 地址（通过 Nginx 代理）
# ⭐ 重要：后端使用 /ws namespace，需要完整路径
VITE_WS_URL=https://onespecial.me/ws

# 启用 Yjs/CRDT 实时协同(与开发环境一致)。
# VITE_YJS_WS_URL 指向 Nginx 代理到后端 Hocuspocus(app:1234)的 /yjs 路径。
# 若部署后协同无法连接,可临时设 VITE_USE_YJS=false 回退到 Socket.IO 模式再排查代理。
VITE_USE_YJS=true
VITE_YJS_WS_URL=wss://onespecial.me/yjs

# 应用标题
VITE_APP_TITLE=文档平台

# 环境标识
NODE_ENV=production
